         <dc:format>application/pdf</dc:format>
         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Flatbed truck realistic vector illustration</rdf:li>
            </rdf:Alt>
         </dc:title>
         <dc:creator>
            <rdf:Seq>
               <rdf:li>Yuri Schmidt</rdf:li>
            </rdf:Seq>
         </dc:creator>
         <dc:description>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Flatbed truck vector mockup on white for vehicle branding, corporate identity. View from side, front, back, and top. All elements in the groups on separate layers for easy editing and recolor.</rdf:li>
            </rdf:Alt>
         </dc:description>
